{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "None"
    }
  },
  "InfrastructureLogging": {
    "ServiceName": "llmops-service",
    "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
    "IncludeCategory": true,
    "IncludeExceptionStackTrace": false,
    "DatabaseHealthIntervalSeconds": 5,
    "DatabaseHealthTimeoutSeconds": 3,
    "ExcludedPaths": ["/health", "/observability", "/cost", "/prompts", "/providers", "/approvals"],
    "StateFields": ["dependency", "operation", "duration_ms", "address", "connection_id", "request_id",
      "model", "user", "budget", "completion_tokens_price", "prompt_tokens_price",
      "today_usd", "threshold_percent", "usage_percent", "requested_model", "selected_model"],
    "FrameworkMessages": {
      "Microsoft.AspNetCore.Server.Kestrel:13": "Unhandled application exception"
    }
  }
}
